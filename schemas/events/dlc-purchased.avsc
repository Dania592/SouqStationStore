{
  "type": "record",
  "namespace": "com.souqstation.shared.events",
  "name": "DLCPurchasedEvent",
  "doc": "Événement : DLC acheté par un utilisateur",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Identifiant unique de l'événement"
    },
    {
      "name": "eventType",
      "type": "string",
      "default": "dlc.purchased",
      "doc": "Type d'événement"
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Timestamp d'occurrence"
    },
    {
      "name": "schemaVersion",
      "type": "int",
      "default": 1,
      "doc": "Version du schéma"
    },
    {
      "name": "purchaseId",
      "type": "string",
      "doc": "Identifiant unique de l'achat/transaction"
    },
    {
      "name": "userId",
      "type": "string",
      "doc": "Identifiant de l'acheteur"
    },
    {
      "name": "dlcId",
      "type": "string",
      "doc": "Identifiant du DLC acheté"
    },
    {
      "name": "dlcName",
      "type": "string",
      "doc": "Nom du DLC acheté"
    },
    {
      "name": "gameId",
      "type": "string",
      "doc": "Identifiant du jeu parent"
    },
    {
      "name": "publisherId",
      "type": "string",
      "doc": "Identifiant de l'éditeur"
    },
    {
      "name": "price",
      "type": "double",
      "doc": "Prix payé"
    },
    {
      "name": "purchasedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Date et heure de l'achat"
    }
  ]
}
