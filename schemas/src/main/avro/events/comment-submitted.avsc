{
  "type": "record",
  "namespace": "com.souqstation.schemas.events",
  "name": "CommentSubmittedEvent",
  "doc": "Événement : Commentaire soumis sur une évaluation ou correctif",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Identifiant unique de l'événement"
    },
    {
      "name": "eventType",
      "type": "string",
      "default": "comment.submitted",
      "doc": "Type d'événement"
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Timestamp d'occurrence"
    },
    {
      "name": "schemaVersion",
      "type": "int",
      "default": 1,
      "doc": "Version du schéma"
    },
    {
      "name": "commentId",
      "type": "string",
      "doc": "Identifiant unique du commentaire"
    },
    {
      "name": "gameId",
      "type": "string",
      "doc": "Identifiant du jeu parent (pour contexte)"
    },
    {
      "name": "parentId",
      "type": "string",
      "doc": "ID de l'entité parente (review/patch/game)"
    },
    {
      "name": "parentType",
      "type": {
        "type": "enum",
        "namespace": "com.souqstation.schemas.events.enums",
        "name": "CommentParentType",
        "symbols": [
          "REVIEW",
          "PATCH",
          "GAME"
        ]
      },
      "doc": "Type d'entité parente"
    },
    {
      "name": "userId",
      "type": "string",
      "doc": "Identifiant de l'auteur du commentaire"
    },
    {
      "name": "pseudo",
      "type": "string",
      "doc": "Pseudo de l'auteur"
    },
    {
      "name": "contenu",
      "type": "string",
      "doc": "Contenu du commentaire"
    },
    {
      "name": "dateEmission",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Date d'émission du commentaire"
    }
  ]
}
