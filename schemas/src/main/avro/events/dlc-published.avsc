{
  "type": "record",
  "namespace": "com.souqstation.schemas.events",
  "name": "DLCPublishedEvent",
  "doc": "Événement : Contenu téléchargeable (DLC) publié",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Identifiant unique de l'événement"
    },
    {
      "name": "eventType",
      "type": "string",
      "default": "dlc.published",
      "doc": "Type d'événement"
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Timestamp d'occurrence"
    },
    {
      "name": "schemaVersion",
      "type": "int",
      "default": 1,
      "doc": "Version du schéma"
    },
    {
      "name": "dlcId",
      "type": "string",
      "doc": "Identifiant unique du DLC"
    },
    {
      "name": "gameId",
      "type": "string",
      "doc": "Identifiant du jeu parent"
    },
    {
      "name": "name",
      "type": "string",
      "doc": "Nom du DLC"
    },
    {
      "name": "description",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Description du contenu"
    },
    {
      "name": "publisherId",
      "type": "string",
      "doc": "Identifiant de l'éditeur"
    },
    {
      "name": "price",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Prix du DLC"
    },
    {
      "name": "releaseDate",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Date de sortie du DLC"
    }
  ]
}
