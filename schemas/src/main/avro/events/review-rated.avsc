{
  "type": "record",
  "namespace": "com.souqstation.schemas.events",
  "name": "ReviewRatedEvent",
  "doc": "Événement : Évaluation d'une évaluation (utile/pas utile) par un utilisateur",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Identifiant unique de l'événement"
    },
    {
      "name": "eventType",
      "type": "string",
      "default": "review.rated",
      "doc": "Type d'événement"
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Timestamp d'occurrence"
    },
    {
      "name": "schemaVersion",
      "type": "int",
      "default": 1,
      "doc": "Version du schéma"
    },
    {
      "name": "ratingId",
      "type": "string",
      "doc": "Identifiant unique de cette évaluation d'évaluation"
    },
    {
      "name": "reviewId",
      "type": "string",
      "doc": "Identifiant de l'évaluation notée"
    },
    {
      "name": "userId",
      "type": "string",
      "doc": "Identifiant de l'utilisateur qui note"
    },
    {
      "name": "isHelpful",
      "type": "boolean",
      "doc": "L'évaluation est-elle utile ? (true=utile, false=pas utile)"
    },
    {
      "name": "ratedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Date de notation"
    }
  ]
}
