{
  "type": "record",
  "name": "UserRegistered",
  "namespace": "com.souqstation.schemas.events",
  "doc": "Event emitted when a user registers on the platform.",
  "fields": [
    { "name": "eventId", "type": "string", "doc": "UUID as string" },
    {
      "name": "occurredAt",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Event time in epoch millis"
    },
    { "name": "userId", "type": "string" },
    { "name": "name", "type": "string" },
    { "name": "birth", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "email", "type": "string" },
    { "name": "displayName", "type": "string" },
    { "name": "createdAt", "type": { "type": "long", "logicalType": "timestamp-millis" } }

  ]
}